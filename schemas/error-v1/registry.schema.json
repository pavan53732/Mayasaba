{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/error-v1/registry.schema.json",
  "title":"Mayasaba canonical error registry",
  "type":"object",
  "additionalProperties":false,
  "required":["version","codes"],
  "properties":{
    "version":{"const":"1.0.0"},
    "codes":{"type":"object","additionalProperties":{"type":"object","required":["category","retryability","severity","mcf_code"],"properties":{
      "category":{"type":"string"},"retryability":{"type":"string"},"severity":{"type":"string"},"mcf_code":{"type":"string"},"tauri_code":{"type":"string"},"remediation":{"type":"string"}
    }}}
  }
}
