{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/simulation-v1/simulation.schema.json",
  "title":"Mayasaba deterministic simulation",
  "type":"object","additionalProperties":false,
  "required":["simulation_id","scenario_id","seed","faults"],
  "properties":{
    "simulation_id":{"type":"string","format":"uuid"},"scenario_id":{"type":"string"},"seed":{"type":"integer","minimum":0},
    "faults":{"type":"object","properties":{
      "latency_ms":{"type":"integer","minimum":0},"duplicate_rate":{"type":"number","minimum":0,"maximum":1},
      "drop_rate":{"type":"number","minimum":0,"maximum":1},"reorder":{"type":"boolean"},"ack_loss":{"type":"boolean"},
      "malformed_payloads":{"type":"boolean"},"stale_context":{"type":"boolean"},"capability_loss":{"type":"boolean"},
      "adapter_crash":{"type":"boolean"},"timeout":{"type":"boolean"},"build_failure":{"type":"boolean"},"test_failure":{"type":"boolean"},
      "repair_regression":{"type":"boolean"},"conflicting_proposals":{"type":"boolean"}
    }},
    "expected_outcome":{"type":["string","null"]}
  }
}
