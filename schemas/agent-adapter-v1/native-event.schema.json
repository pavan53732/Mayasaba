{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/agent-adapter-v1/native-event.schema.json",
  "title":"Mayasaba normalized native adapter event",
  "type":"object","additionalProperties":false,
  "required":["agent_type","transport","native_kind","received_at","raw_ref"],
  "properties":{
    "agent_type":{"enum":["HERMES_AGENT","KILO_CODE","OPEN_CODE"]},
    "transport":{"enum":["HERMES_STREAM_JSON","KILO_JSON","OPEN_CODE_JSON","ACP_STDIO","UNSUPPORTED"]},
    "native_kind":{"enum":["SESSION_STARTED","TEXT","REASONING","STEP_START","STEP_FINISH","TOOL_CALL","TOOL_RESULT","FILE_CHANGE","COMMAND_REQUEST","COMMAND_RESULT","ERROR","RESULT","SESSION_ENDED","HEARTBEAT","UNKNOWN"]},
    "native_session_id":{"type":["string","null"]},
    "received_at":{"type":"string","format":"date-time"},
    "raw_ref":{"type":"string"},
    "payload":{"type":"object"}
  }
}
