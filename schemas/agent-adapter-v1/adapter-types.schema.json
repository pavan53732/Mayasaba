{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/agent-adapter-v1/adapter-types.schema.json",
  "title":"Mayasaba Agent Adapter Type Registry",
  "type":"object",
  "additionalProperties":false,
  "required":["types"],
  "properties":{
    "types":{"type":"object","additionalProperties":false,"properties":{
      "AgentInstallation":{"type":"object","required":["agent_type","executable","resolved_path","version","platform"],"properties":{
        "agent_type":{"enum":["HERMES_AGENT","KILO_CODE","OPEN_CODE"]},
        "executable":{"type":"string"},"resolved_path":{"type":"string"},"version":{"type":"string"},"platform":{"type":"string"}
      }},
      "AgentVersion":{"type":"object","required":["raw","major","minor","patch"],"properties":{
        "raw":{"type":"string"},"major":{"type":"integer","minimum":0},"minor":{"type":"integer","minimum":0},"patch":{"type":"integer","minimum":0},"prerelease":{"type":["string","null"]}
      }},
      "CapabilitySet":{"type":"object","additionalProperties":{"type":"boolean"}},
      "HealthStatus":{"type":"object","required":["state","checked_at"],"properties":{
        "state":{"enum":["HEALTHY","DEGRADED","UNHEALTHY","UNKNOWN"]},"checked_at":{"type":"string","format":"date-time"},"detail":{"type":["string","null"]}
      }},
      "SessionLaunch":{"type":"object","required":["project_id","session_id","workspace_id","cwd","transport"],"properties":{
        "project_id":{"type":"string","format":"uuid"},"session_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"cwd":{"type":"string"},
        "transport":{"enum":["HERMES_STREAM_JSON","KILO_JSON","OPEN_CODE_JSON","ACP_STDIO","UNSUPPORTED"]},"prompt_ref":{"type":["string","null"]}
      }},
      "AgentSessionHandle":{"type":"object","required":["process_id"],"properties":{"process_id":{"type":"integer","minimum":1},"native_session_id":{"type":["string","null"]}}},
      "SendReceipt":{"type":"object","required":["message_id","accepted","received_at"],"properties":{"message_id":{"type":"string","format":"uuid"},"accepted":{"type":"boolean"},"received_at":{"type":"string","format":"date-time"}}},
      "NativeEventStream":{"type":"object","required":["transport"],"properties":{"transport":{"type":"string"},"protocol_version":{"type":["string","null"]}}},
      "StopReason":{"enum":["USER_STOP","TASK_CANCEL","PROJECT_STOP","TIMEOUT","POLICY","FAILURE","RECOVERY"]},
      "ChangeScope":{"type":"object","required":["workspace_id","allowed_paths"],"properties":{"workspace_id":{"type":"string","format":"uuid"},"allowed_paths":{"type":"array","items":{"type":"string"}}}},
      "ChangeSet":{"type":"object","required":["files"],"properties":{"files":{"type":"array","items":{"type":"object"}},"diff_ref":{"type":["string","null"]},"checkpoint_ref":{"type":["string","null"]}}},
      "EvidenceScope":{"type":"object","required":["task_id","workspace_id"],"properties":{"task_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"kinds":{"type":"array","items":{"type":"string"}}}},
      "EvidenceRefs":{"type":"object","required":["evidence_ids"],"properties":{"evidence_ids":{"type":"array","items":{"type":"string","format":"uuid"}}}},
      "AdapterError":{"type":"object","required":["category","code","retryability","message"],"properties":{
        "category":{"enum":["DETECTION","LAUNCH","TRANSPORT","PARSE","PROCESS","TIMEOUT","CANCELLATION","AUTHENTICATION","CAPABILITY","WORKSPACE","PROTOCOL"]},
        "code":{"type":"string"},"retryability":{"enum":["NEVER","IMMEDIATE","BACKOFF","AFTER_SYNC","AFTER_REASSIGNMENT","AFTER_USER_ACTION"]},"message":{"type":"string"},
        "causation_id":{"type":["string","null"],"format":"uuid"}
      }}
    }}
  }
}
