{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Mayasaba Agent Adapter Probe Result",
  "type":"object",
  "required":["schema_version","agent_type","probe_time","executable","version","platform","transport","invocation","capabilities","exit_semantics","authentication"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "agent_type":{"enum":["HERMES_AGENT","KILO_CODE","OPEN_CODE"]},
    "probe_time":{"type":"string","format":"date-time"},
    "executable":{"type":"string"},
    "resolved_path":{"type":["string","null"]},
    "version":{"type":"string"},
    "platform":{"type":"string"},
    "transport":{"enum":["HERMES_STREAM_JSON","KILO_JSON","OPEN_CODE_JSON","ACP_STDIO","UNSUPPORTED"]},
    "invocation":{"type":"object","required":["argv","cwd","stdin_mode","stdout_mode","stderr_mode"],"properties":{
      "argv":{"type":"array","items":{"type":"string"}},
      "cwd":{"type":"string"},
      "stdin_mode":{"type":"string"},
      "stdout_mode":{"type":"string"},
      "stderr_mode":{"type":"string"}
    }},
    "capabilities":{"type":"object","additionalProperties":{"type":"boolean"}},
    "exit_semantics":{"type":"object","required":["exit_code","terminated_by_signal","timeout"],"properties":{
      "exit_code":{"type":["integer","null"]},"terminated_by_signal":{"type":"boolean"},"timeout":{"type":"boolean"}
    }},
    "authentication":{"type":"object","required":["detected","method"],"properties":{
      "detected":{"type":"boolean"},"method":{"type":"string"}
    }},
    "raw_probe_evidence":{"type":"array","items":{"type":"string"}},
    "warnings":{"type":"array","items":{"type":"string"}}
  }
}