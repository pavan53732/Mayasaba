{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/error.schema.json",
  "title": "Mayasaba structured error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "severity",
    "retryability",
    "message",
    "correlation_id"
  ],
  "properties": {
    "code": {
      "enum": [
        "MCF_SCHEMA_INVALID",
        "MCF_UNKNOWN_MESSAGE_TYPE",
        "MCF_UNKNOWN_EVENT_TYPE",
        "MCF_PROJECT_MISMATCH",
        "MCF_SESSION_MISMATCH",
        "MCF_UNAUTHORIZED",
        "MCF_POLICY_DENIED",
        "MCF_CAPABILITY_UNAVAILABLE",
        "MCF_STALE_CONTEXT",
        "MCF_EPOCH_MISMATCH",
        "MCF_LEASE_INVALID",
        "MCF_LEASE_EXPIRED",
        "MCF_WORKSPACE_MISMATCH",
        "MCF_DUPLICATE_CONFLICT",
        "MCF_SEQUENCE_GAP",
        "MCF_IDEMPOTENCY_CONFLICT",
        "MCF_TIMEOUT",
        "MCF_CANCELED",
        "MCF_PROCESS_FAILED",
        "MCF_ADAPTER_UNAVAILABLE",
        "MCF_ADAPTER_PROTOCOL_ERROR",
        "MCF_AUTH_REQUIRED",
        "MCF_UNSUPPORTED_VERSION",
        "MCF_DEAD_LETTER",
        "MCF_INTERNAL"
      ]
    },
    "category": {
      "enum": [
        "SCHEMA",
        "IDENTITY",
        "AUTHORIZATION",
        "POLICY",
        "CAPABILITY",
        "CONTEXT",
        "LEASE",
        "WORKSPACE",
        "SEQUENCE",
        "IDEMPOTENCY",
        "TIMEOUT",
        "CANCELLATION",
        "PROCESS",
        "ADAPTER",
        "AUTHENTICATION",
        "VERSION",
        "DEAD_LETTER",
        "INTERNAL"
      ]
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "retryability": {
      "enum": [
        "NEVER",
        "IMMEDIATE",
        "BACKOFF",
        "AFTER_SYNC",
        "AFTER_REASSIGNMENT",
        "AFTER_USER_ACTION"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
