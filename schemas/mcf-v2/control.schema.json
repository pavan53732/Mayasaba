{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/control.schema.json",
  "title": "MCF-v2 control payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "enum": [
        "PAUSE",
        "RESUME",
        "CANCEL",
        "STOP",
        "RETRY",
        "DEAD_LETTER",
        "SYNC",
        "REPLAY"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "grace_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
