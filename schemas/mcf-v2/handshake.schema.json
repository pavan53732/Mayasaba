{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/mcf-v2/handshake.schema.json",
  "title":"MCF-v2 agent handshake",
  "type":"object","additionalProperties":false,
  "required":["agent_id","agent_type","adapter_version","protocol_versions","capabilities"],
  "properties":{
    "agent_id":{"type":"string","format":"uuid"},
    "agent_type":{"enum":["HERMES_AGENT","KILO_CODE","OPEN_CODE"]},
    "adapter_version":{"type":"string"},
    "protocol_versions":{"type":"array","items":{"const":"MCF-2"}},
    "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "native_transport":{"type":"string"},
    "workspace_id":{"type":["string","null"],"format":"uuid"}
  }
}
