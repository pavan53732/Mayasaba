{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/handoff.schema.json",
  "title": "Mayasaba HandoffPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "task_id",
    "sender_agent_id",
    "sender_session_id",
    "receiver_agent_id",
    "status",
    "completed_work",
    "pending_work",
    "changed_files",
    "tests",
    "current_context"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "sender_agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "sender_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "receiver_agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "REQUESTED",
        "PACKAGE_BUILT",
        "OFFERED",
        "RECEIVER_ACCEPTED",
        "OWNERSHIP_TRANSFERRED",
        "VERIFIED",
        "CLOSED",
        "REJECTED"
      ]
    },
    "completed_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diff_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoint_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "affected_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_context": {
      "type": "object",
      "required": [
        "context_snapshot_id",
        "project_epoch",
        "state_digest"
      ],
      "properties": {
        "context_snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "state_digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
