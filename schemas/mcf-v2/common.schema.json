{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_.-]{1,127}$"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
