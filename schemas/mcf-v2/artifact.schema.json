{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/artifact.schema.json",
  "title": "Mayasaba Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "project_id",
    "kind",
    "path",
    "sha256",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "FILE",
        "DIRECTORY",
        "DIFF",
        "BUILD_OUTPUT",
        "TEST_OUTPUT",
        "LOG",
        "BUNDLE"
      ]
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_agent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
