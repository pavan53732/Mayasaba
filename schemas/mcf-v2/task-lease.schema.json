{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/task-lease.schema.json",
  "title": "Mayasaba TaskLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "lease_version",
    "task_id",
    "project_id",
    "agent_id",
    "session_id",
    "workspace_id",
    "project_epoch",
    "context_snapshot_id",
    "state_digest",
    "allowed_paths",
    "required_capabilities",
    "issued_at",
    "expires_at",
    "heartbeat_interval_seconds",
    "status"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "context_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_interval_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "required_validation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "REQUESTED",
        "ACTIVE",
        "RENEWING",
        "EXPIRED",
        "RELEASED",
        "REVOKED"
      ]
    }
  }
}
