{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/sync.schema.json",
  "title": "MCF-v2 synchronization payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sync_kind",
    "project_epoch"
  ],
  "properties": {
    "sync_kind": {
      "enum": [
        "REQUEST",
        "RESPONSE",
        "STATE_DIGEST",
        "CONTEXT_UPDATE",
        "STALE_CONTEXT",
        "EPOCH_CHANGED"
      ]
    },
    "project_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "context_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "state_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "from_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "to_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "missing_message_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
