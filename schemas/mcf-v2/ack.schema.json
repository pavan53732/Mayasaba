{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/ack.schema.json",
  "title": "MCF-v2 ACK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "receipt_id",
    "received_at",
    "duplicate",
    "persisted"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "duplicate": {
      "type": "boolean"
    },
    "persisted": {
      "const": true
    },
    "prior_outcome_event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
