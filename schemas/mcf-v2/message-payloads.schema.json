{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/mcf-v2/message-payloads.schema.json",
  "title":"MCF-v2 message payload registry schema",
  "type":"object","additionalProperties":false,
  "required":["registry_version","authority","messages"],
