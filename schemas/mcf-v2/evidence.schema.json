{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/evidence.schema.json",
  "title": "Mayasaba Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "project_id",
    "kind",
    "source",
    "created_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "COMMAND_RESULT",
        "TEST_RESULT",
        "BUILD_RESULT",
        "RUNTIME_RESULT",
        "REVIEW",
        "FILE_HASH",
        "DIFF",
        "SCREENSHOT",
        "LOG",
        "PROBE_RESULT"
      ]
    },
    "source": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "validation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
