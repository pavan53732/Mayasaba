{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/task.schema.json",
  "title": "Mayasaba Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "objective",
    "status",
    "priority",
    "allowed_paths",
    "required_capabilities",
    "validation_requirements"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
