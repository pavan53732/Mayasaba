{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/identity.schema.json",
  "title": "MCF-v2 actor identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_type",
    "actor_id"
  ],
  "properties": {
    "actor_type": {
      "enum": [
        "MAYASABA",
        "AGENT"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_type": {
      "enum": [
        "CLAUDE_CODE",
        "HERMES_AGENT",
        "KILO_CODE",
        "CLINE",
        null
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
