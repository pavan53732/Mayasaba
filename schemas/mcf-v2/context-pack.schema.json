{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/context-pack.schema.json",
  "title": "Mayasaba ContextPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_snapshot_id",
    "project_epoch",
    "state_digest",
    "objective",
    "requirements",
    "decisions",
    "architecture_refs",
    "task",
    "workspace_scope",
    "validation_requirements"
  ],
  "properties": {
    "context_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "architecture_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "workspace_scope": {
      "type": "object",
      "required": [
        "workspace_id",
        "root",
        "allowed_paths"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "root": {
          "type": "string"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest_inputs": {
      "type": "object"
    }
  }
}
