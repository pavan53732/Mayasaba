{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/enums.schema.json",
  "title": "MCF-v2 enums",
  "type": "object",
  "properties": {
    "priority": {
      "$ref": "#/$defs/priority"
    },
    "message_type": {
      "$ref": "message-types.schema.json"
    },
    "event_type": {
      "$ref": "event-types.schema.json"
    }
  },
  "$defs": {
    "priority": {
      "type": "string",
      "enum": [
        "EMERGENCY_CONTROL",
        "SYNCHRONIZATION",
        "TASK_CONTROL",
        "FAILURE_RECOVERY",
        "COUNCIL",
        "PROGRESS_HEARTBEAT",
        "BULK"
      ]
    }
  }
}
