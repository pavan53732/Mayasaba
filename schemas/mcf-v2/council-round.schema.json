{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/mcf-v2/council-round.schema.json",
  "title": "Mayasaba Council Round",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round_id",
    "project_id",
    "state",
    "participants"
  ],
  "properties": {
    "round_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "OPEN",
        "RESPONSES_COLLECTING",
        "CRITIQUE",
        "REBUTTAL",
        "REVISION",
        "DISAGREEMENT_REVIEW",
        "CLOSING",
        "SEALED"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "barrier_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "round_index": {
      "type": "integer",
      "minimum": 1
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "converged": {
      "type": "boolean"
    },
    "outcome": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "outcome_type"
      ],
      "properties": {
        "outcome_type": {
          "enum": [
            "CONVERGED", "CAP_REACHED", "ESCALATED", "SEALED_WITH_OPEN_QUESTION", "SYNTHESIZED"
          ]
        },
        "synthesis_position_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "decided_position_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "open_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "escalation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "sealed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
