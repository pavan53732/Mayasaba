{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/council-v1/escalation.schema.json",
  "title": "Mayasaba Council Escalation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "escalation_id",
    "project_id",
    "round_id",
    "reason",
    "positions",
    "conflict_matrix",
    "recommendation",
    "timeout_behavior"
  ],
  "properties": {
    "escalation_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "round_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "enum": [
        "CONVERGENCE_FAILED",
        "ROUND_CAP_REACHED",
        "MATERIAL_DISAGREEMENT",
        "BLOCKING_QUESTION"
      ]
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_id",
          "author_agent_id",
          "summary"
        ],
        "properties": {
          "position_id": {
            "type": "string",
            "format": "uuid"
          },
          "author_agent_id": {
            "type": "string",
            "format": "uuid"
          },
          "summary": {
            "type": "string"
          },
          "strongest_argument": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_objections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conflict_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "stances"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "format": "uuid"
          },
          "requirement_statement": {
            "type": [
              "string",
              "null"
            ]
          },
          "stances": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "agent_id",
                "position_id",
                "stance"
              ],
              "properties": {
                "agent_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "position_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "stance": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "position_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_authoritative": {
          "const": false
        }
      }
    },
    "timeout_behavior": {
      "const": "PAUSE"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
