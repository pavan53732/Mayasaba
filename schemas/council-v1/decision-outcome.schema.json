{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/council-v1/decision-outcome.schema.json",
  "title":"Mayasaba Council Decision Outcome Record",
  "type":"object",
  "additionalProperties":false,
  "required":["outcome_record_id","decision_id","mode","decision_class","status","source","recorded_at","informational_only"],
  "properties":{
    "outcome_record_id":{"type":"string","format":"uuid"},
    "decision_id":{"type":"string","format":"uuid"},
    "council_session_id":{"type":["string","null"],"format":"uuid"},
    "round_id":{"type":["string","null"],"format":"uuid"},
    "mode":{"enum":["SOLO","REVIEW","FULL"]},
    "decision_class":{"enum":["ARCHITECTURE","STACK_TECHNOLOGY","IRREVERSIBLE","SECURITY","DATA_LOSS","ROUTINE"]},
    "status":{"enum":["HELD","AMENDED","REVERSED","UNRESOLVED"]},
    "validation_evidence_id":{"type":["string","null"],"format":"uuid"},
    "source":{"enum":["VALIDATION_RESULT","REOPEN_DECISION","USER_SUPERSESSION"]},
    "supersedes_outcome_id":{"type":["string","null"],"format":"uuid"},
    "recorded_at":{"type":"string","format":"date-time"},
    "informational_only":{"const":true},
    "agent_links":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["agent_id","stance"],
        "properties":{
          "agent_id":{"type":"string","format":"uuid"},
          "position_id":{"type":["string","null"],"format":"uuid"},
          "stance":{"type":"string"}
        }
      }
    }
  },
  "allOf":[
    {
      "if":{"required":["status"],"properties":{"status":{"const":"HELD"}}},
      "then":{"required":["validation_evidence_id"],"properties":{"validation_evidence_id":{"type":"string"}}}
    }
  ],
  "description":"Append-only, and derived only from controller facts: a validation result, the reopen_decision command, or decision supersession. No agent claim can produce one. HELD is the only status asserting the decision survived, so it alone requires a validation evidence reference; the conditional above and the SQLite CHECK constrain the same rule. `informational_only` is pinned true because this record must not influence routing, thresholds, mode selection or authority; using it that way would be a hidden second authority and requires its own decision. Supersession appends a new record and there is no update or delete path."
}
