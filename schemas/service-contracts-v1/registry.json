{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "schema_version":"1.0.0",
  "authority":"schemas/service-contracts-v1/registry.json",
  "operation_rules":{
    "request_response":"Every operation has a named request and response type.",
    "errors":"Every operation references canonical MCF/Tauri error codes.",
    "cancellation":"Long-running operations declare cancellation support.",
    "ownership":"Each operation has exactly one owner service."
  },
  "services":{
    "ProjectService":["create_project","open_project","get_project","list_projects","record_user_contribution"],
    "LifecycleService":["pause_project","resume_project","stop_project","abandon_project","get_project_status"],
    "AgentService":["launch_agent","stop_agent","pause_agent","resume_agent","get_agent_status"],
    "CouncilService":["answer_user_question","get_council_round","open_round","submit_round_result","close_round"],
    "RequirementService":["list_requirements","upsert_requirement"],
    "DecisionService":["list_decisions","reopen_decision","upsert_decision"],
    "ArchitectureService":["get_architecture","upsert_architecture"],
    "AttachmentService":["attach_project_context_attachment","list_project_context_attachments","resolve_project_context_attachment"],
    "ContextService":["request_sync","get_context_status","create_context","validate_freshness"],
    "TaskService":["get_task_graph","retry_task","reassign_task","create_task","lease_task","renew_lease","release_lease"],
    "WorkspaceService":["get_workspace_status","validate_workspace","request_preview","rollback_workspace","prepare_workspace","checkpoint_workspace"],
    "ExecutionService":["execute_command","cancel_command","get_execution_status"],
    "BuildService":["get_build_status","run_build"],
    "TestService":["get_test_runs","run_tests"],
    "ValidationService":["request_validation","get_validation_status"],
    "RepairService":["get_failures","get_repairs","retry_repair","create_repair"],
    "EvidenceService":["get_evidence","publish_artifact","publish_evidence"],
    "ReviewService":["get_reviews","record_review"],
    "PolicyService":["approve_action","get_action_admissibility","authorize_action"],
    "RecoveryService":["replay_event","replay_dead_letter","start_recovery","get_recovery_status","resolve_recovery"],
    "ConfigurationService":["get_configuration","update_configuration","validate_configuration"],
    "SimulationService":["start_simulation","stop_simulation","get_simulation_status"],
    "DiagnosticsService":["get_logs","get_communication_health","get_doctor_report"]
  },
  "types":{
    "GenericRequest":{"required":["request_id"],"properties":{"request_id":{"type":"string","format":"uuid"},"project_id":{"type":["string","null"],"format":"uuid"},"payload":{"type":"object"}}},
    "GenericResponse":{"required":["request_id","status"],"properties":{"request_id":{"type":"string","format":"uuid"},"status":{"enum":["ACCEPTED","REJECTED","COMPLETED"]},"result":{"type":["object","null"]},"error":{"type":["object","null"]}}},
    "Cancellation":{"properties":{"cancellable":{"type":"boolean"},"cancel_command":{"type":["string","null"]}}}
  }
}
