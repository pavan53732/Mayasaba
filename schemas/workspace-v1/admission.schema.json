{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayasaba.local/schemas/workspace-v1/admission.schema.json",
  "title": "Mayasaba Workspace Admission Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_id",
    "project_id",
    "task_id",
    "workspace_id",
    "kind",
    "epoch",
    "checks",
    "verdict"
  ],
  "properties": {
    "admission_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "WORKSPACE_ADMISSION",
        "INTEGRATION_ADMISSION"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "context_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_checkpoint_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "REPOSITORY_IDENTITY",
              "BASELINE_CLEAN",
              "WORKTREE_ASSIGNED",
              "PROTECTED_PATHS_DETERMINED",
              "LEASE_BOUND",
              "LEASE_OWNERSHIP",
              "CONTEXT_FRESH",
              "WORKSPACE_OWNERSHIP",
              "BASE_CHECKPOINT_VALID",
              "TESTS_EVIDENCE_PRESENT",
              "PROTECTED_PATH_CLEAN",
              "DEPENDENCY_CONFLICT_CLEAR"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "ADMITTED",
        "REFUSED",
        "BLOCKED"
      ]
    },
    "refusal_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "PATH_OVERLAP",
          "PROTECTED_PATH",
          "SCHEMA_OR_CONTRACT_FILE_CONFLICT",
          "DEPENDENCY_MANIFEST_CONFLICT",
          "STALE_BASE",
          "POST_MERGE_VALIDATION_FAILURE"
        ]
      }
    },
    "supersedes_admission_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ADMITTED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "REFUSED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "refusal_reasons"
        ],
        "properties": {
          "refusal_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "refusal_reasons": {
            "contains": {
              "const": "POST_MERGE_VALIDATION_FAILURE"
            }
          }
        },
        "required": [
          "refusal_reasons"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "INTEGRATION_ADMISSION"
          }
        }
      }
    }
  ]
}
