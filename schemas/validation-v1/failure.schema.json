{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/validation-v1/failure.schema.json",
  "title":"Mayasaba Failure Packet","type":"object","additionalProperties":false,
  "required":["failure_id","project_id","category","fingerprint","command","exit_code","scope","requirements","attempts"],
  "properties":{
    "failure_id":{"type":"string","format":"uuid"},"project_id":{"type":"string","format":"uuid"},
    "task_id":{"type":["string","null"],"format":"uuid"},"category":{"type":"string"},"fingerprint":{"type":"string","minLength":1},
    "command":{"type":"string"},"exit_code":{"type":["integer","null"]},"stdout_ref":{"type":["string","null"]},"stderr_ref":{"type":["string","null"]},
    "scope":{"type":"object"},"requirements":{"type":"array","items":{"type":"string"}},"attempts":{"type":"integer","minimum":0}
  }
}
