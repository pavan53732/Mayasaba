{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/validation-v1/review.schema.json",
  "title":"Mayasaba Review","type":"object","additionalProperties":false,
  "required":["review_id","project_id","scope","reviewer_agent_id","findings","verdict"],
  "properties":{
    "review_id":{"type":"string","format":"uuid"},"project_id":{"type":"string","format":"uuid"},"task_id":{"type":["string","null"],"format":"uuid"},
    "scope":{"type":"object"},"reviewer_agent_id":{"type":"string","format":"uuid"},
    "findings":{"type":"array","items":{"type":"object","required":["severity","message"],"properties":{"severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL"]},"message":{"type":"string"},"path":{"type":["string","null"]}}}},
    "verdict":{"enum":["PASS","FAIL","BLOCKED"]},"created_at":{"type":["string","null"],"format":"date-time"}
  }
}
