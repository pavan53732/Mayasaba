{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mayasaba.local/schemas/validation-v1/diagnosis.schema.json",
  "title":"Mayasaba Failure Diagnosis","type":"object","additionalProperties":false,
  "required":["diagnosis_id","failure_id","agent_id","finding","confidence","proposed_actions"],
  "properties":{
    "diagnosis_id":{"type":"string","format":"uuid"},"failure_id":{"type":"string","format":"uuid"},"agent_id":{"type":"string","format":"uuid"},
    "finding":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},
    "root_cause_refs":{"type":"array","items":{"type":"string"}},"proposed_actions":{"type":"array","items":{"type":"string"}}
  }
}
