# ====================================================================
# Mayasaba — Git Ignore Configuration
# ====================================================================

# --- CMake & Root Build Outputs ---
build/
build-*/
out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json

# --- Isolated staging copies for delegated workers (parent integrates; never tracked) ---
.staging/
staging/

# --- WinUI 3 / C++/WinRT / MSBuild (app/Mayasaba.App) ---
Generated Files/
obj/
bin/
x64/
x86/
ARM64/
Win32/
AppPackages/
BundleArtifacts/
packages/

# --- Visual Studio & MSVC Artifacts ---
.vs/
*.vcxproj.user
*.user
*.userosv
*.suo
*.sln.docstates

# --- C++ Binaries, Libraries & Symbols ---
*.obj
*.lib
*.dll
*.exe
*.pdb
*.idb
*.ilk
*.exp
*.pch
*.ipch

# --- MSBuild Logs & State ---
*.log
!docs/implementation/logs/*.log
*.tlog
*.lastbuildstate
nul

# --- WiX Toolset / Installer Outputs ---
*.wixobj
*.wixpdb
*.msi
*.msm
installer/build/
installer/obj/
installer/bin/
# Staged payload and the generated payload fragment (produced by scripts/build-installer.ps1)
installer/staging/
installer/payload.generated.wxs

# --- Third-Party Download Caches & Temporary Extraction Dirs ---
third_party/dl/
third_party/*_tmp/
*.zip
*.tar.gz
*.tgz

# --- Coding CLIs & Agent State ---
.kilo/
.hermes/
.claude/
.*-tmp*
*.tmp
.workbuddy-ai/

# --- IDE & AI Tool State ---
.vscode/
.gemini/
.claude/
.cursor/
.windsurf/

# --- SQLite Runtime Databases & Journals ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
.mayasaba/

# --- Windows System & Crash Dumps ---
*.dmp
Thumbs.db
desktop.ini
$RECYCLE.BIN/
