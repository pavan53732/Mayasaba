# Kilo Code CLI local state and worktrees
.kilo/

# WorkBuddy AI local state
.workbuddy-ai/

# Cargo build output. Added after `git add -A` committed 3057 files from target/ in 8c19151.
# target/ is regenerated by `cargo build` and must never be tracked.
/target/

# Frontend dependencies and build output, regenerated by `npm install` and `vite build`.
node_modules/
dist/

# VS Code editor settings, local per-developer and not part of the product.
.vscode/

# axme-code local state
.axme-code/

# clj-kondo local state
.clj-kondo/

# clojure-lsp local state: .lsp/.cache/db.transit.json is clojure-lsp's analysis cache, whose content
# records this machine's project root and kondo config hashes. Tool state, not product content.
.lsp/
