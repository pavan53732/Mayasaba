<?xml version="1.0" encoding="utf-8"?>
<!--
  Mayasaba Control Room — Chat.

  This is the ONLY top-level route. There is no navigation rail, tab bar, dashboard or standalone
  Council/Requirements/Decisions/Tasks/Files/Validation/Delivery/Settings/Agents page: every
  background subsystem becomes a concise timeline card, an inline expansion, or the temporary
  dismissible details sheet layered over Chat below.

  The shell has three persistent regions, as fixed by UI-UX.md section 3:
    1. compact Chat header   — project identity, phase + condition, Stop, overflow menu
    2. conversation timeline — messages and controller cards in chronological order
    3. Chat footer           — lower-left Open Folder plus the single composer and Send
-->
<Page
    x:Class="Mayasaba.App.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mayasaba.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    Background="{ThemeResource CanvasBrush}">

    <Page.Resources>

        <!-- One controller-offered action on a card. The click handler reads the action from the
             button's DataContext, so no tree walk and no Tag marshalling are needed. -->
        <DataTemplate x:Key="CardActionTemplate" x:DataType="local:CardActionView">
            <Button Style="{StaticResource CardActionButtonStyle}"
                    Content="{x:Bind Label}"
                    Click="OnCardActionClick"
                    AutomationProperties.Name="{x:Bind Label}" />
        </DataTemplate>

        <!-- One pending attachment chip. -->
        <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="local:AttachmentChip">
            <Border Style="{StaticResource AttachmentChipStyle}"
                    AutomationProperties.Name="{x:Bind AccessibilityName}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource TextMeta}"
                               Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource TextMeta}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind StateText}" Style="{StaticResource TextMeta}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                            Padding="4" MinWidth="22" MinHeight="22"
                            Click="OnRemoveAttachmentClick"
                            AutomationProperties.Name="Remove attachment">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One exception-only agent warning row: only MISSING / UNSUPPORTED / PROBE_FAILED. -->
        <DataTemplate x:Key="AgentNoticeTemplate" x:DataType="local:AgentNotice">
            <Border Style="{StaticResource AttentionRowStyle}"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Bind AccessibilityName}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons"
                               FontSize="16" Foreground="{ThemeResource AttentionBrush}"
                               VerticalAlignment="Top" Margin="0,2,0,0"
                               AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource TextCardTitle}"
                                       FontSize="{StaticResource FontSizeBody}" />
                            <TextBlock Text="{x:Bind Readiness}" Style="{StaticResource TextMeta}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource TextBody}"
                                   Visibility="{x:Bind ReasonVisibility}" />
                        <TextBlock Text="{x:Bind Effect}" Style="{StaticResource TextMeta}" />
                        <TextBlock Text="{x:Bind Guidance}" Style="{StaticResource TextMeta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Top">
                        <Button Content="Locate executable"
                                Style="{StaticResource CardActionButtonStyle}"
                                Visibility="{x:Bind LocateVisibility}"
                                Click="OnLocateExecutableClick"
                                AutomationProperties.Name="Locate the installed executable for this CLI" />
                        <Button Content="Recheck"
                                Style="{StaticResource CardActionButtonStyle}"
                                Click="OnRecheckAgentClick"
                                AutomationProperties.Name="Recheck this CLI's readiness" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One timeline entry: a conversational message bubble or a controller card with the
             evidence spine. Colour and glyph are never the only cue; the kind label and the
             state word always accompany them. -->
        <DataTemplate x:Key="TimelineItemTemplate" x:DataType="local:TimelineCard">
            <Grid>
                <!-- Conversational message (user or named agent) -->
                <Border Style="{x:Bind CardStyle}"
                        Visibility="{x:Bind MessageVisibility}"
                        AutomationProperties.Name="{x:Bind AccessibilityName}"
                        AutomationProperties.AutomationId="{x:Bind CardId}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Author}" Style="{StaticResource TextKindLabel}" />
                            <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource TextMeta}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind TimestampVisibility}" />
                            <TextBlock Text="Provisional" Style="{StaticResource TextMeta}"
                                       Foreground="{ThemeResource ProvisionalBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ProvisionalVisibility}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource TextBodyLarge}"
                                   Visibility="{x:Bind TitleVisibility}" />
                        <TextBlock Text="{x:Bind Body}" Style="{StaticResource TextBodyLarge}"
                                   Visibility="{x:Bind BodyVisibility}" />
                    </StackPanel>
                </Border>

                <!-- Controller card with the evidence spine -->
                <Border Style="{x:Bind CardStyle}"
                        Visibility="{x:Bind CardVisibility}"
                        AutomationProperties.Name="{x:Bind AccessibilityName}"
                        AutomationProperties.AutomationId="{x:Bind CardId}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Grid Grid.Column="0" Width="3" VerticalAlignment="Stretch">
                            <Rectangle Fill="{ThemeResource AuthorityBrush}" RadiusX="1.5" RadiusY="1.5"
                                       Visibility="{x:Bind SpineInfoVisibility}" />
                            <Rectangle Fill="{ThemeResource AttentionBrush}" RadiusX="1.5" RadiusY="1.5"
                                       Visibility="{x:Bind SpineAttentionVisibility}" />
                            <Rectangle Fill="{ThemeResource CriticalBrush}" RadiusX="1.5" RadiusY="1.5"
                                       Visibility="{x:Bind SpineErrorVisibility}" />
                            <Rectangle Fill="{ThemeResource SuccessBrush}" RadiusX="1.5" RadiusY="1.5"
                                       Visibility="{x:Bind SpineSuccessVisibility}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons"
                                           FontSize="14" Foreground="{ThemeResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="{x:Bind KindLabel}" Style="{StaticResource TextKindLabel}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind State}" Style="{StaticResource TextMeta}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind StateVisibility}" />
                                <TextBlock Text="Provisional" Style="{StaticResource TextMeta}"
                                           Foreground="{ThemeResource ProvisionalBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ProvisionalVisibility}" />
                                <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource TextMeta}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind TimestampVisibility}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource TextCardTitle}"
                                       Visibility="{x:Bind TitleVisibility}" />
                            <TextBlock Text="{x:Bind Body}" Style="{StaticResource TextBody}"
                                       Visibility="{x:Bind BodyVisibility}" />
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{x:Bind ProgressVisibility}"
                                         Margin="0,2,0,2"
                                         AutomationProperties.Name="Work in progress" />
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ActionsVisibility}" Margin="0,2,0,0">
                                <ItemsControl ItemsSource="{x:Bind Actions}"
                                              ItemTemplate="{StaticResource CardActionTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Content="Show details"
                                        Style="{StaticResource CardActionButtonStyle}"
                                        Visibility="{x:Bind DetailsVisibility}"
                                        Click="OnShowDetailsClick"
                                        AutomationProperties.Name="Show details for this card" />
                                <Button Content="Dismiss"
                                        Style="{StaticResource CardActionButtonStyle}"
                                        Visibility="{x:Bind DismissVisibility}"
                                        Click="OnDismissCardClick"
                                        AutomationProperties.Name="Dismiss this card" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ CHAT HEADER ============================ -->
        <Grid x:Name="ChatHeader"
              Grid.Row="0"
              Padding="{StaticResource PadShell}"
              Background="{ThemeResource SurfaceBrush}"
              BorderBrush="{ThemeResource SeparatorBrush}"
              BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectNameText" Text="No project bound"
                               Style="{StaticResource TextBody}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectPathText" Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="360"
                               ToolTipService.ToolTip="Canonical project root"
                               AutomationProperties.Name="Canonical project root" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PhaseText" Style="{StaticResource TextMeta}"
                               AutomationProperties.Name="Project lifecycle phase" />
                    <TextBlock Text="·" Style="{StaticResource TextMeta}"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ConditionText" Style="{StaticResource TextMeta}"
                               AutomationProperties.Name="Operational condition" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <ProgressRing x:Name="CheckingRing" IsActive="False" Width="16" Height="16"
                                  Margin="0,0,4,0"
                                  AutomationProperties.Name="Checking installed CLIs" />
                    <Button x:Name="StopButton" Style="{StaticResource SubtleIconButtonStyle}"
                            Click="OnStopClick" IsEnabled="False"
                            ToolTipService.ToolTip="Stop the active operation"
                            AutomationProperties.Name="Stop the active operation">
                        <TextBlock Text="Stop" FontSize="{StaticResource FontSizeCaption}" />
                    </Button>
                    <Button x:Name="OverflowButton" Style="{StaticResource SubtleIconButtonStyle}"
                            AutomationProperties.Name="More actions">
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="MenuOpenFolder" Text="Open folder…"
                                                Click="OnOpenFolderClick" />
                                <MenuFlyoutItem x:Name="MenuCopyPath" Text="Copy canonical path"
                                                Click="OnCopyPathClick" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="MenuEnterSends"
                                                      Text="Enter sends the message"
                                                      IsChecked="True"
                                                      Click="OnEnterSendsToggleClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuDiagnostics" Text="Technical diagnostics"
                                                Click="OnDiagnosticsClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================ TIMELINE ============================ -->
        <Grid x:Name="TimelineRegion" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Shell-level error state: a controller that could not start, or a query that
                 failed. Readable state is preserved; the interface is never blanked. -->
            <Border x:Name="ShellErrorCard" Grid.Row="0" Visibility="Collapsed"
                    Margin="16,12,16,0" HorizontalAlignment="Left"
                    Style="{StaticResource Card_Error}"
                    AutomationProperties.Name="Shell error">
                <StackPanel Spacing="6">
                    <TextBlock Text="Error" Style="{StaticResource TextKindLabel}"
                               Foreground="{ThemeResource CriticalBrush}" />
                    <TextBlock x:Name="ShellErrorTitle" Style="{StaticResource TextCardTitle}" />
                    <TextBlock x:Name="ShellErrorBody" Style="{StaticResource TextBody}" />
                </StackPanel>
            </Border>

            <!-- Exception-only CLI warnings. Healthy READY agents never appear here. -->
            <ItemsControl x:Name="AgentAttentionStrip" Grid.Row="1" Visibility="Collapsed"
                          Margin="16,12,16,0" MaxWidth="{StaticResource CardMaxWidth}"
                          HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource AgentNoticeTemplate}"
                          AutomationProperties.Name="CLI warnings" />

            <!-- The conversation column: centered, bounded reading measure, virtualized. -->
            <ListView x:Name="TimelineList" Grid.Row="2"
                      ItemTemplate="{StaticResource TimelineItemTemplate}"
                      ItemContainerStyle="{StaticResource TimelineItemContainerStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      Padding="16,8,16,8"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Chat timeline"
                      AutomationProperties.LiveSetting="Polite" />

            <!-- Empty state: no project bound. Chat stays usable; Send stays disabled. -->
            <Grid x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="520" Spacing="16">
                    <local:LogoMark Width="72" Height="72" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Text="One project reality, three agent sessions"
                               Style="{StaticResource TextSubtitle}" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource TextBody}" TextAlignment="Center"
                               Foreground="{ThemeResource MutedBrush}"
                               Text="Mayasaba keeps one authoritative record of your project while Hermes, Kilo Code and OpenCode work as separate sessions. Open a folder to bind the project root — opening it does not scan, launch or change anything." />
                    <Button x:Name="EmptyOpenFolderButton" Style="{StaticResource OpenFolderButtonStyle}"
                            HorizontalAlignment="Center" Click="OnOpenFolderClick"
                            AutomationProperties.Name="Open a project folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontFamily="Segoe Fluent Icons"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="Open Folder" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource TextMeta}" TextAlignment="Center"
                               Text="Send stays disabled until an authorized project root is bound." />
                </StackPanel>
            </Grid>

            <!-- Bounded loading state: never a spinner that blocks folder selection. -->
            <Grid x:Name="LoadingState" Grid.Row="2" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="28" Height="28"
                                  AutomationProperties.Name="Loading Chat" />
                    <TextBlock Text="Loading Chat history…" Style="{StaticResource TextMeta}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Button x:Name="JumpToLatestButton" Grid.Row="3" Visibility="Collapsed"
                    Style="{StaticResource CardActionButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,0,0,12"
                    Click="OnJumpToLatestClick"
                    AutomationProperties.Name="Jump to the latest message">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="12"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Jump to latest" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============================ CHAT FOOTER ============================ -->
        <Grid x:Name="ChatFooter"
              Grid.Row="2"
              Padding="{StaticResource PadShell}"
              Background="{ThemeResource SurfaceBrush}"
              BorderBrush="{ThemeResource SeparatorBrush}"
              BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <!-- Open Folder stays at the lower-left and never looks like Attach files. -->
                <Button x:Name="OpenFolderButton" Grid.Column="0"
                        Style="{StaticResource OpenFolderButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="OnOpenFolderClick"
                        AutomationProperties.Name="Open or switch the project folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontFamily="Segoe Fluent Icons"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="OpenFolderButtonText" Text="Open Folder"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Spacing="8">
                    <ItemsControl x:Name="AttachmentChips" Visibility="Collapsed"
                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="Pending attachments">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="{ThemeResource SurfaceAltBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusM}"
                            Padding="4"
                            AllowDrop="True"
                            DragOver="OnComposerDragOver"
                            Drop="OnComposerDrop">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Button x:Name="AttachButton" Grid.Column="0"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Click="OnAttachClick"
                                    ToolTipService.ToolTip="Attach files"
                                    AutomationProperties.Name="Attach files">
                                <FontIcon Glyph="&#xE723;" FontFamily="Segoe Fluent Icons"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </Button>
                            <TextBox x:Name="ComposerBox" Grid.Column="1"
                                     Style="{StaticResource ComposerTextBoxStyle}"
                                     PlaceholderText="Message Mayasaba…"
                                     TextChanged="OnComposerTextChanged"
                                     KeyDown="OnComposerKeyDown"
                                     AutomationProperties.Name="Message Mayasaba" />
                            <Button x:Name="SendButton" Grid.Column="2"
                                    Style="{StaticResource SendButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Click="OnSendClick"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Send message"
                                    AutomationProperties.HelpText="Send is disabled until an authorized project root is bound.">
                                <TextBlock Text="Send" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SendHintText" Style="{StaticResource TextMeta}"
                               Text="Open a folder to send." />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===================== TEMPORARY DETAILS SHEET =====================
             Not a route and not pinnable: it opens over Chat, is dismissed with Close or Escape,
             and restores timeline scroll position, keyboard focus and screen-reader context. -->
        <Grid x:Name="DetailsOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{ThemeResource ScrimBrush}">
            <Border x:Name="DetailsSheet" Style="{StaticResource SheetSurfaceStyle}" Margin="24,24,24,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          Background="{ThemeResource SurfaceBrush}"
                          BorderBrush="{ThemeResource SeparatorBrush}"
                          BorderThickness="0,0,0,1">
                        <local:LogoMark Grid.Column="0" Width="20" Height="20"
                                        VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailsTitle" Style="{StaticResource TextSubtitle}"
                                       Text="Details" />
                            <TextBlock x:Name="DetailsSubtitle" Style="{StaticResource TextMeta}" />
                        </StackPanel>
                        <Button x:Name="DetailsCloseButton" Grid.Column="2"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                Click="OnDetailsCloseClick"
                                AutomationProperties.Name="Close details">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" Padding="16,16,16,16"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Details content">
                        <StackPanel x:Name="DetailsSections" Spacing="20" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Padding="16,10" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8"
                                BorderBrush="{ThemeResource SeparatorBrush}"
                                BorderThickness="0,1,0,0">
                        <TextBlock x:Name="DetailsCardIdText" Style="{StaticResource TextMono}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
