<?xml version="1.0" encoding="utf-8"?>
<!--
  Mayasaba Control Room shell — application definition.

  App.xaml is the XAML `Application` definition (ApplicationDefinition). The XAML compiler
  generates App.xaml.g.h from it, and the WinUI 3 runtime entry point (wWinMain) that calls
  Application::Start. See Main.cpp for the readable, checked-in entry point.
-->
<Application
    x:Class="Mayasaba.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mayasaba.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 default control styles. Required for the Fluent control set. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Mayasaba design system: tokens (light/dark/high-contrast), type ramp, the
                     original mark geometry, the timeline card style set and control styles. -->
                <ResourceDictionary Source="ms-appx:///Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
