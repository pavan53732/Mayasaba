<?xml version="1.0" encoding="utf-8"?>
<!--
  Mayasaba Control Room — control styles and the card style set
  (Theme/Styles.xaml).

  Merges Theme/Tokens.xaml so every StaticResource reference below resolves, then defines:
    * the type ramp used by conversation text and controller cards;
    * the 13-kind timeline card style set (UI-UX.md section 7.1);
    * composer, attachment-chip, action-button and details-sheet styles.

  Card semantics: the left "evidence spine" colour is driven by severity (info / attention /
  error / success) and the card surface tint is driven by kind family. Text, a glyph and a
  state word always accompany colour, so the same card is readable in High Contrast.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================== TYPE RAMP ============================== -->
    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplayFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="TextBodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="TextMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextKindLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource AuthorityBrush}" />
    </Style>

    <Style x:Key="TextCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMonoFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="TextSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========================== TIMELINE CARD STYLE SET ==========================
         Base containers. BubbleBase = conversational message; CardBase = controller card
         carrying the evidence spine. -->
    <Style x:Key="BubbleBase" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="MaxWidth" Value="640" />
    </Style>

    <Style x:Key="CardBase" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="MaxWidth" Value="{StaticResource CardMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- The 13 timeline kinds declared by control::TimelineItem.kind. -->
    <Style x:Key="Card_UserMessage" TargetType="Border" BasedOn="{StaticResource BubbleBase}">
        <Setter Property="Background" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="Card_AgentMessage" TargetType="Border" BasedOn="{StaticResource BubbleBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Card_Status" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    </Style>
    <Style x:Key="Card_Warning" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource AttentionSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AttentionBrush}" />
    </Style>
    <Style x:Key="Card_Question" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuthorityBrush}" />
    </Style>
    <Style x:Key="Card_Progress" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    </Style>
    <Style x:Key="Card_CouncilSummary" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuthorityBrush}" />
    </Style>
    <Style x:Key="Card_RequirementsSummary" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuthorityBrush}" />
    </Style>
    <Style x:Key="Card_Decision" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource AuthoritySoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AuthorityBrush}" />
    </Style>
    <Style x:Key="Card_Task" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    </Style>
    <Style x:Key="Card_Validation" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    </Style>
    <Style x:Key="Card_Delivery" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SuccessBrush}" />
    </Style>
    <Style x:Key="Card_Error" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource CriticalSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CriticalBrush}" />
    </Style>
    <!-- Unknown/future kind falls back to a quiet neutral card rather than dropping the item. -->
    <Style x:Key="Card_Default" TargetType="Border" BasedOn="{StaticResource CardBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    </Style>

    <!-- ============================== CONTAINERS ============================== -->
    <Style x:Key="TimelineItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0,6,0,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="AttachmentChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="10,4,4,4" />
    </Style>

    <Style x:Key="AttentionRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AttentionSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AttentionBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        <Setter Property="Padding" Value="{StaticResource PadCardCompact}" />
        <Setter Property="MaxWidth" Value="{StaticResource CardMaxWidth}" />
    </Style>

    <Style x:Key="SheetSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusL}" />
        <Setter Property="MaxWidth" Value="880" />
        <Setter Property="MaxHeight" Value="640" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CitationStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
        <Setter Property="Padding" Value="{StaticResource PadCardCompact}" />
    </Style>

    <Style x:Key="KeyValuePanelStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SpaceL}" />
    </Style>

    <!-- ================================ BUTTONS ================================ -->
    <Style x:Key="CardActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineWidth}" />
        <Setter Property="Foreground" Value="{ThemeResource AuthorityBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="OpenFolderButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusS}" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FontUIFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="MaxHeight" Value="168" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
