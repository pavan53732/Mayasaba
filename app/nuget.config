<?xml version="1.0" encoding="utf-8"?>
<!--
  Mayasaba.App — WinUI 3 / C++/WinRT desktop app (unpackaged, Windows App SDK self-contained).

  Repo-local NuGet configuration: pin the only package source to nuget.org so a machine-level
  or offline feed cannot make restore non-deterministic or fail.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
