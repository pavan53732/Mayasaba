{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64 (primary local build)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "MAYASABA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2026-asan",
      "displayName": "Visual Studio 2026 x64 with AddressSanitizer",
      "inherits": "vs2026",
      "binaryDir": "${sourceDir}/build/vs2026-asan",
      "cacheVariables": {
        "MAYASABA_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "vs2026-asan-debug", "configurePreset": "vs2026-asan", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    }
  ]
}
