{
  "schema_version": "1.0.0",
  "project": "Mayasaba",
  "platform": "windows",
  "desktop": {
    "path": "apps/desktop",
    "frontend": "react19+typescript+vite",
    "shell": "tauri2",
    "rust_entry": "apps/desktop/src-tauri"
  },
  "rust_workspace": {
    "path": "Cargo.toml",
    "members": [
      "crates/core",
      "crates/protocol",
      "crates/bus",
      "crates/agents",
      "crates/council",
      "crates/tasks",
      "crates/workspace",
      "crates/execution",
      "crates/validation",
      "crates/evidence",
      "crates/policy",
      "crates/storage",
      "apps/desktop/src-tauri"
    ]
  },
  "crates": {
    "core": {
      "path": "crates/core",
      "depends": [
        "protocol",
        "bus",
        "agents",
        "council",
        "tasks",
        "workspace",
        "execution",
        "validation",
        "evidence",
        "policy",
        "storage"
      ]
    },
    "protocol": {
      "path": "crates/protocol",
      "depends": []
    },
    "bus": {
      "path": "crates/bus",
      "depends": [
        "protocol",
        "storage"
      ]
    },
    "agents": {
      "path": "crates/agents",
      "depends": [
        "protocol",
        "execution",
        "workspace"
      ]
    },
    "council": {
      "path": "crates/council",
      "depends": [
        "protocol",
        "storage"
      ]
    },
    "tasks": {
      "path": "crates/tasks",
      "depends": [
        "protocol",
        "storage",
        "agents",
        "workspace"
      ]
    },
    "workspace": {
      "path": "crates/workspace",
      "depends": [
        "storage",
        "policy"
      ]
    },
    "execution": {
      "path": "crates/execution",
      "depends": [
        "storage",
        "policy"
      ]
    },
    "validation": {
      "path": "crates/validation",
      "depends": [
        "execution",
        "workspace",
        "evidence",
        "storage"
      ]
    },
    "evidence": {
      "path": "crates/evidence",
      "depends": [
        "storage"
      ]
    },
    "policy": {
      "path": "crates/policy",
      "depends": [
        "storage"
      ]
    },
    "storage": {
      "path": "crates/storage",
      "depends": []
    }
  },
  "tauri_shell": {
    "path": "apps/desktop/src-tauri",
    "depends": [
      "core",
      "protocol"
    ],
    "packaging": "MSI"
  },
  "schema_sources": [
    "schemas/mcf-v2/registry.json",
    "schemas/mcf-v2/transition-types.json",
    "schemas/tauri-bridge-v1/bridge.schema.json",
    "schemas/agent-adapter-v1/probe-result.schema.json"
  ],
  "rule": "This graph and the service/bridge/schema mappings are authoritative until implementation manifests exist; implementation Cargo/npm/Tauri manifests and generated bridge types must conform to them.",
  "application_services": {
    "ProjectService": "core",
    "LifecycleService": "core",
    "AgentService": "agents",
    "CouncilService": "council",
    "RequirementService": "core",
    "DecisionService": "core",
    "ArchitectureService": "core",
    "ContextService": "core",
    "TaskService": "tasks",
    "WorkspaceService": "workspace",
    "ExecutionService": "execution",
    "BuildService": "validation",
    "TestService": "validation",
    "ValidationService": "validation",
    "RepairService": "core",
    "EvidenceService": "evidence",
    "ReviewService": "validation",
    "PolicyService": "policy",
    "RecoveryService": "core",
    "ConfigurationService": "core",
    "SimulationService": "core",
    "DiagnosticsService": "core"
  },
  "tauri_bridge": {
    "schema": "schemas/tauri-bridge-v1/bridge.schema.json",
    "commands": {
      "create_project": "ProjectService",
      "open_project": "ProjectService",
      "pause_project": "LifecycleService",
      "resume_project": "LifecycleService",
      "stop_project": "LifecycleService",
      "answer_user_question": "CouncilService",
      "reopen_decision": "DecisionService",
      "approve_action": "PolicyService",
      "retry_task": "TaskService",
      "reassign_task": "TaskService",
      "retry_repair": "RepairService",
      "launch_agent": "AgentService",
      "stop_agent": "AgentService",
      "request_sync": "ContextService",
      "request_preview": "WorkspaceService",
      "replay_event": "RecoveryService",
      "replay_dead_letter": "RecoveryService"
    },
    "queries": {
      "get_project": "ProjectService",
      "list_projects": "ProjectService",
      "get_project_status": "LifecycleService",
      "get_agent_status": "AgentService",
      "get_council_round": "CouncilService",
      "list_requirements": "RequirementService",
      "list_decisions": "DecisionService",
      "get_architecture": "ArchitectureService",
      "get_context_status": "ContextService",
      "get_task_graph": "TaskService",
      "get_workspace_status": "WorkspaceService",
      "get_build_status": "BuildService",
      "get_test_runs": "TestService",
      "get_failures": "RepairService",
      "get_repairs": "RepairService",
      "get_reviews": "ReviewService",
      "get_evidence": "EvidenceService",
      "get_logs": "DiagnosticsService",
      "get_communication_health": "DiagnosticsService"
    },
    "events": {
      "PROJECT_UPDATED": "ProjectService",
      "PROJECT_PHASE_CHANGED": "LifecycleService",
      "PROJECT_STATUS_CHANGED": "LifecycleService",
      "AGENT_SESSION_CHANGED": "AgentService",
      "AGENT_HEALTH_CHANGED": "AgentService",
      "AGENT_CAPABILITY_CHANGED": "AgentService",
      "COUNCIL_ROUND_CHANGED": "CouncilService",
      "COUNCIL_MESSAGE_RECEIVED": "CouncilService",
      "COUNCIL_BARRIER_CHANGED": "CouncilService",
      "REQUIREMENT_CHANGED": "RequirementService",
      "DECISION_CHANGED": "DecisionService",
      "ARCHITECTURE_CHANGED": "ArchitectureService",
      "CONTEXT_CHANGED": "ContextService",
      "TASK_CHANGED": "TaskService",
      "LEASE_CHANGED": "TaskService",
      "HANDOFF_CHANGED": "TaskService",
      "WORKSPACE_CHANGED": "WorkspaceService",
      "EXECUTION_CHANGED": "ExecutionService",
      "BUILD_CHANGED": "BuildService",
      "TEST_CHANGED": "TestService",
      "VALIDATION_CHANGED": "ValidationService",
      "FAILURE_RECORDED": "RepairService",
      "REPAIR_CHANGED": "RepairService",
      "ARTIFACT_PUBLISHED": "EvidenceService",
      "EVIDENCE_PUBLISHED": "EvidenceService",
      "REVIEW_RECORDED": "ReviewService",
      "COMMUNICATION_CHANGED": "DiagnosticsService",
      "DEAD_LETTER_RECORDED": "DiagnosticsService",
      "RECOVERY_STARTED": "RecoveryService",
      "RECOVERY_COMPLETED": "RecoveryService"
    }
  },
  "schema_distribution": {
    "authoritative_sources": [
      "schemas/mcf-v2/registry.json",
      "schemas/mcf-v2/transition-types.json",
      "schemas/tauri-bridge-v1/bridge.schema.json",
      "schemas/agent-adapter-v1/probe-result.schema.json"
    ],
    "runtime_distribution": "embedded",
    "embedding_owner": "crates/protocol",
    "embedding_mechanism": "Rust include_str!/include_bytes! or equivalent compile-time embedding",
    "msi_runtime_dependency": "none",
    "rule": "Runtime validation must not depend on repository-relative files after installation; schema source files remain build-time inputs."
  }
}
