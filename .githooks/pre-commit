#!/bin/sh
# Mayasaba pre-commit contract gate (DEC-036 local validation, DEC-040 event emitters).
#
# This hook is version-controlled on purpose. It lives in .githooks/ and is activated by a single
# config pointer:
#
#     git config core.hooksPath .githooks
#
# so there is exactly ONE copy of it, in git, and nothing that can drift from a stale copy in
# .git/hooks. core.hooksPath is a pointer rather than a copy, so there is no installer script: the
# whole state of this mechanism is readable with `git config core.hooksPath`.
set -e
npm run --silent verify:contracts
